# Appwrite Configuration (optional — for cloud user profiles)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key

# Ollama Configuration (optional — defaults to localhost:11434)
OLLAMA_HOST=http://localhost:11434

# GitHub OAuth (optional — for repo connection)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Blockchain (optional — for funding test wallets on Sepolia)
FUNDER_PRIVATE_KEY=

# Premium / Remote Inference (optional — for hosted AI tier)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it:free
OPENROUTER_DAILY_LIMIT=100

# Server Configuration
NODE_ENV=development
